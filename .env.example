# Copy to .env and fill in. .env is gitignored; never commit real passwords.
#   cp .env.example .env
# Generate keys with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_hex(32))"

# --- Airflow ---
# Linux: set to your user id (id -u) so files written to the mounted folders belong to you.
# Windows / macOS with Docker Desktop: keep 50000.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=change-me
AIRFLOW_WEBSERVER_PORT_HOST=8080

# --- Airflow metadata database (Postgres) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow

# --- ClickHouse ---
CLICKHOUSE_USER=observatory
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_HTTP_PORT_HOST=8123
CLICKHOUSE_NATIVE_PORT_HOST=9000

# --- Paths inside the Airflow / dbt containers (host folders are ./dbt, ./data, ./scripts, ./clickhouse/init) ---
DBT_PROJECT_DIR=/opt/airflow/dbt
DBT_PROFILES_DIR=/opt/airflow/dbt
DBT_TARGET=dev
DATA_DIR=/opt/airflow/data
SCRIPTS_DIR=/opt/airflow/scripts
CLICKHOUSE_INIT_DIR=/opt/airflow/clickhouse/init

# --- RIK open-data files ---
# Date part of the annual-report file names, e.g. 1.aruannete_yldandmed_kuni_31102026_1.zip -> 31102026.
# Changes monthly; check https://avaandmed.ariregister.rik.ee/en/downloading-open-data
RIK_FILE_VERSION=31102026
RIK_YEARS=2022,2023,2024,2025
